+
+func findBootedUKIFile(ukiFiles []string, defaultEntry, selectedEntry, oneShotEntry, rebootReason string) (string, bool) {
+	if rebootReason == "reboot" && oneShotEntry == "kexec reboot" {
+		if entry, ok := findMatchingUKIFile(ukiFiles, defaultEntry); ok {
+			return entry, true
+		}
+
+		return findMatchingUKIFile(ukiFiles, selectedEntry)
+	}
+
+	if entry, ok := findMatchingUKIFile(ukiFiles, selectedEntry); ok {
+		return entry, true
+	}
+
+	return findMatchingUKIFile(ukiFiles, defaultEntry)
+}
+
+func findNextBootUKIFile(ukiFiles []string, defaultEntry, selectedEntry string) (string, bool) {
+	if entry, ok := findMatchingUKIFile(ukiFiles, defaultEntry); ok {
+		return entry, true
+	}
+
+	return findMatchingUKIFile(ukiFiles, selectedEntry)
+}
+
+func resolveBootEntries(ukiFiles []string, defaultEntry, selectedEntry, oneShotEntry, rebootReason, loaderDefault string, efiVariablesAvailable bool) (string, bool, string, bool) {
+	var (
+		bootedEntry     string
+		bootedEntryOk   bool
+		loaderEntry     string
+		nextBootEntry   string
+		nextBootEntryOk bool
+	)
+
+	if entry, ok := findMatchingUKIPattern(ukiFiles, loaderDefault); ok {
+		loaderEntry = entry
+		nextBootEntry, nextBootEntryOk = entry, true
+	}
+
+	if efiVariablesAvailable && (loaderEntry == "" || strings.EqualFold(loaderEntry, defaultEntry)) {
+		bootedEntry, bootedEntryOk = findBootedUKIFile(ukiFiles, defaultEntry, selectedEntry, oneShotEntry, rebootReason)
+	}
+
+	if !bootedEntryOk && loaderEntry != "" {
+		bootedEntry, bootedEntryOk = loaderEntry, true
+	}
+
+	if !nextBootEntryOk {
+		nextBootEntry, nextBootEntryOk = findNextBootUKIFile(ukiFiles, defaultEntry, selectedEntry)
+	}
+
+	if len(ukiFiles) == 1 {
+		if !bootedEntryOk {
+			bootedEntry, bootedEntryOk = filepath.Base(ukiFiles[0]), true
+		}
+
+		if !nextBootEntryOk {
+			nextBootEntry, nextBootEntryOk = filepath.Base(ukiFiles[0]), true
+		}
+	}
+
+	return bootedEntry, bootedEntryOk, nextBootEntry, nextBootEntryOk
+}
+
+func findMatchingUKIPattern(ukiFiles []string, pattern string) (string, bool) {
+	if pattern == "" {
+		return "", false
+	}
+
+	for _, file := range ukiFiles {
+		matched, err := filepath.Match(pattern, filepath.Base(file))
+		if err == nil && matched {
+			return filepath.Base(file), true
+		}
+	}
+
+	return "", false
+}
+
+func readLoaderDefault(path string) (string, error) {
+	contents, err := os.ReadFile(path)
+	if err != nil {
+		return "", err
+	}
+
+	for _, line := range strings.Split(string(contents), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && strings.EqualFold(fields[0], "default") {
+			return fields[1], nil
+		}
+	}
+
+	return "", errors.New("loader.conf has no default entry")
+}
+
+func writeLoaderConfig(path string, base []byte, ukiFileName string) error {
+	lines := strings.Split(string(base), "\n")
+	filtered := lines[:0]
+
+	for _, line := range lines {
+		fields := strings.Fields(line)
+		if len(fields) > 0 {
+			switch strings.ToLower(fields[0]) {
+			case "default", "editor", "timeout":
+				continue
+			}
+		}
+
+		filtered = append(filtered, line)
+	}
+
+	contents := fmt.Appendf(
+		[]byte(strings.TrimRight(strings.Join(filtered, "\n"), "\n")),
+		"\n\ndefault %s\ntimeout 5\neditor no\n",
+		filepath.Base(ukiFileName),
+	)
+
+	return os.WriteFile(path, contents, 0o644)
+}

+func TestFindMatchingUKIPattern(t *testing.T) {
+	t.Parallel()
+
+	existingFiles := []string{
+		"/boot/EFI/EFI/Linux/Talos-v1.13.9.efi",
+		"/boot/EFI/EFI/Linux/Talos-v1.14.0.efi",
+	}
+
+	foundFile, found := sdboot.FindMatchingUKIPattern(existingFiles, "Talos-v1.14.0*")
+	require.True(t, found)
+	require.Equal(t, "Talos-v1.14.0.efi", foundFile)
+
+	_, found = sdboot.FindMatchingUKIPattern(existingFiles, "Talos-v1.15.0*")
+	require.False(t, found)
+}

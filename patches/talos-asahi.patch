+func TestLoaderConfig(t *testing.T) {
+	t.Parallel()
+
+	path := filepath.Join(t.TempDir(), "loader.conf")
+	base := append([]byte(nil), sdboot.LoaderConfBytes...)
+	base = append(base, []byte("\nsecure-boot-enroll manual\n")...)
+	require.NoError(t, sdboot.WriteLoaderConfig(path, base, "Talos-v1.14.0.efi"))
+
+	contents, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.Equal(t, "# systemd-boot configuration\n\nsecure-boot-enroll manual\n\ndefault Talos-v1.14.0*\ntimeout 5\neditor no\n", string(contents))
+
+	entry, err := sdboot.ReadLoaderDefault(path)
+	require.NoError(t, err)
+	require.Equal(t, "Talos-v1.14.0*", entry)
+}

+			},
+			defaultEntry:          "Talos-current.efi",
+			selectedEntry:         "Talos-old.efi",
+			efiVariablesAvailable: true,
+			expectedBooted:        "Talos-old.efi",
+			expectedNext:          "Talos-current.efi",

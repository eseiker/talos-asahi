+++ b/internal/app/machined/pkg/runtime/v1alpha1/bootloader/sdboot/internal/bootentry/bootentry.go
@@ -94,3 +94,63 @@ func NextBoot(ukiFiles []string, defaultEntry, selectedEntry string) (string, bo
 
 	return Match(ukiFiles, selectedEntry)
 }
+
+// MatchPattern returns the first UKI file whose name matches the loader.conf style glob pattern.
+func MatchPattern(ukiFiles []string, pattern string) (string, bool) {
+	if pattern == "" {
+		return "", false
+	}
+
+	for _, file := range ukiFiles {
+		matched, err := filepath.Match(pattern, filepath.Base(file))
+		if err == nil && matched {
+			return filepath.Base(file), true
+		}
+	}
+
+	return "", false
+}
+
+// Resolve returns the booted and next boot UKI entries, treating the loader.conf default as authoritative.
+//
+// Asahi's U-Boot does not reliably provide writable/persistent EFI variables, so loader.conf decides the
+// next boot, and the EFI variables are only used to tell the booted entry apart when their persistent
+// default agrees with loader.conf.
+func Resolve(ukiFiles []string, defaultEntry, selectedEntry, oneShotEntry, rebootReason, loaderDefault string, efiVariablesAvailable bool) (string, bool, string, bool) {
+	var (
+		bootedEntry     string
+		bootedEntryOk   bool
+		loaderEntry     string
+		nextBootEntry   string
+		nextBootEntryOk bool
+	)
+
+	if entry, ok := MatchPattern(ukiFiles, loaderDefault); ok {
+		loaderEntry = entry
+		nextBootEntry, nextBootEntryOk = entry, true
+	}
+
+	if efiVariablesAvailable && (loaderEntry == "" || strings.EqualFold(loaderEntry, defaultEntry)) {
+		bootedEntry, bootedEntryOk = Booted(ukiFiles, defaultEntry, selectedEntry, oneShotEntry, rebootReason)
+	}
+
+	if !bootedEntryOk && loaderEntry != "" {
+		bootedEntry, bootedEntryOk = loaderEntry, true
+	}
+
+	if !nextBootEntryOk {
+		nextBootEntry, nextBootEntryOk = NextBoot(ukiFiles, defaultEntry, selectedEntry)
+	}
+
+	if len(ukiFiles) == 1 {
+		if !bootedEntryOk {
+			bootedEntry, bootedEntryOk = filepath.Base(ukiFiles[0]), true
+		}
+
+		if !nextBootEntryOk {
+			nextBootEntry, nextBootEntryOk = filepath.Base(ukiFiles[0]), true
+		}
+	}
+
+	return bootedEntry, bootedEntryOk, nextBootEntry, nextBootEntryOk
+}

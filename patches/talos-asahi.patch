+func TestFindMatchingUKIPattern(t *testing.T) {
+	t.Parallel()
+
+	existingFiles := []string{
+		"/boot/EFI/EFI/Linux/Talos-v1.13.9.efi",
+		"/boot/EFI/EFI/Linux/Talos-v1.14.0.efi",
+	}
+
+	foundFile, found := sdboot.FindMatchingUKIPattern(existingFiles, "Talos-v1.14.0*")
+	require.True(t, found)
+	require.Equal(t, "Talos-v1.14.0.efi", foundFile)
+
+	_, found = sdboot.FindMatchingUKIPattern(existingFiles, "Talos-v1.15.0*")
+	require.False(t, found)
+}
+
+func TestLoaderConfig(t *testing.T) {
+	t.Parallel()
+
+	path := filepath.Join(t.TempDir(), "loader.conf")
+	require.NoError(t, sdboot.WriteLoaderConfig(path, "Talos-v1.14.0.efi"))
+
+	contents, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.Equal(t, "# systemd-boot configuration\n\ndefault Talos-v1.14.0*\ntimeout 5\neditor no\n", string(contents))
+
+	entry, err := sdboot.ReadLoaderDefault(path)
+	require.NoError(t, err)
+	require.Equal(t, "Talos-v1.14.0*", entry)
+}

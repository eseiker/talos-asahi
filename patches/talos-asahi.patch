@@ -0,0 +1,58 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+// Package loaderconf reads and writes the default entry of the sd-boot loader.conf.
+package loaderconf
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// ReadDefault returns the default entry pattern from loader.conf.
+func ReadDefault(path string) (string, error) {
+	contents, err := os.ReadFile(path)
+	if err != nil {
+		return "", err
+	}
+
+	for line := range strings.SplitSeq(string(contents), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && strings.EqualFold(fields[0], "default") {
+			return fields[1], nil
+		}
+	}
+
+	return "", errors.New("loader.conf has no default entry")
+}
+
+// Write writes loader.conf from base, replacing any default, editor and timeout settings with
+// the given UKI as the default entry.
+func Write(path string, base []byte, ukiFileName string) error {
+	lines := strings.Split(string(base), "\n")
+	filtered := lines[:0]
+
+	for _, line := range lines {
+		fields := strings.Fields(line)
+		if len(fields) > 0 {
+			switch strings.ToLower(fields[0]) {
+			case "default", "editor", "timeout":
+				continue
+			}
+		}
+
+		filtered = append(filtered, line)
+	}
+
+	contents := fmt.Appendf(
+		[]byte(strings.TrimRight(strings.Join(filtered, "\n"), "\n")),
+		"\n\ndefault %s\ntimeout 5\neditor no\n",
+		filepath.Base(ukiFileName),
+	)
+
+	return os.WriteFile(path, contents, 0o644)
+}

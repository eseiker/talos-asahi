+	} {
+		t.Run(testData.name, func(t *testing.T) {
+			t.Parallel()
+
+			bootedEntry, bootedOK, nextBootEntry, nextBootOK := bootentry.Resolve(
+				testData.existingFiles,
+				testData.defaultEntry,
+				testData.selectedEntry,
+				testData.oneShotEntry,
+				testData.rebootReason,
+				testData.loaderDefault,
+				testData.efiVariablesAvailable,
+			)

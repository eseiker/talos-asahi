+
+package loaderconf_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/siderolabs/talos/internal/app/machined/pkg/runtime/v1alpha1/bootloader/sdboot/internal/loaderconf"
+)
+
+func TestWriteAndReadDefault(t *testing.T) {
+	t.Parallel()
+
+	path := filepath.Join(t.TempDir(), "loader.conf")
+	base := []byte("# systemd-boot configuration\n\ntimeout 10\n\nsecure-boot-enroll manual\n")
+	require.NoError(t, loaderconf.Write(path, base, "Talos-v1.14.0.efi"))
+
+	contents, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.Equal(t, "# systemd-boot configuration\n\n\nsecure-boot-enroll manual\n\ndefault Talos-v1.14.0.efi\ntimeout 5\neditor no\n", string(contents))
+
+	entry, err := loaderconf.ReadDefault(path)
+	require.NoError(t, err)
+	require.Equal(t, "Talos-v1.14.0.efi", entry)
+
+	// rewriting keeps a single default entry
+	require.NoError(t, loaderconf.Write(path, contents, "/EFI/Linux/Talos-v1.15.0.efi"))
+
+	entry, err = loaderconf.ReadDefault(path)
+	require.NoError(t, err)
+	require.Equal(t, "Talos-v1.15.0.efi", entry)
+}
+
+func TestReadDefaultMissing(t *testing.T) {
+	t.Parallel()
+
+	path := filepath.Join(t.TempDir(), "loader.conf")
+	require.NoError(t, os.WriteFile(path, []byte("# systemd-boot configuration\n"), 0o644))
+
+	_, err := loaderconf.ReadDefault(path)
+	require.Error(t, err)
+
+	_, err = loaderconf.ReadDefault(filepath.Join(t.TempDir(), "missing.conf"))
+	require.Error(t, err)
+}

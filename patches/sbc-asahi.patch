+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package main
+
+import (
+	"context"
+	"os"
+	"os/signal"
+
+	"github.com/siderolabs/talos/pkg/machinery/overlay"
+	"github.com/siderolabs/talos/pkg/machinery/overlay/adapter"
+)
+
+func main() {
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt)
+	defer cancel()
+
+	adapter.Execute(ctx, &AsahiInstaller{})
+}
+
+// AsahiInstaller intentionally leaves the paired Asahi ESP untouched. m1n1,
+// U-Boot, device trees, and vendor firmware are provisioned by the Asahi
+// installer; Talos only owns the standard fallback EFI loader and UKIs.
+type AsahiInstaller struct{}
+
+type asahiExtraOptions struct {
+	Console    []string `json:"console"`
+}
+
+func (i *AsahiInstaller) GetOptions(_ context.Context, extra asahiExtraOptions) (overlay.Options, error) {
+	kernelArgs := []string{
+		"console=tty0",
+		"talos.dashboard.disabled=1",
+	}
+
+	kernelArgs = append(kernelArgs, extra.Console...)
+
+	return overlay.Options{
+		Name:       "asahi",
+		KernelArgs: kernelArgs,
+	}, nil
+}
+
+func (i *AsahiInstaller) Install(_ context.Context, _ overlay.InstallOptions[asahiExtraOptions]) error {
+	return nil
+}

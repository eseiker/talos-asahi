diff --git a/kernel/build/configure-asahi-arm64.sh b/kernel/build/configure-asahi-arm64.sh
new file mode 100755
index 0000000..759f860
--- /dev/null
+++ b/kernel/build/configure-asahi-arm64.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+source_dir="${1:-/src}"
+cd "${source_dir}"
+
+# Apple PCIe still requires a 16 KiB kernel page size in the Asahi
+# downstream tree. Keep boot-critical platform drivers built-in.
+scripts/config \
+  --enable ARCH_APPLE \
+  --enable ARM64_MEMORY_MODEL_CONTROL \
+  --enable APPLE_AIC \
+  --enable APPLE_WATCHDOG \
+  --enable APPLE_DART \
+  --enable APPLE_SART \
+  --enable APPLE_MAILBOX \
+  --enable APPLE_RTKIT \
+  --enable APPLE_RTKIT_HELPER \
+  --enable MFD_MACSMC \
+  --enable APPLE_PMGR_PWRSTATE \
+  --enable APPLE_PMGR_MISC \
+  --enable I2C_APPLE \
+  --enable NVME_APPLE \
+  --enable PCIE_APPLE \
+  --enable PINCTRL_APPLE_GPIO \
+  --enable PWM_APPLE \
+  --enable SPI_APPLE \
+  --enable SPMI_APPLE \
+  --enable GPIO_MACSMC \
+  --module SENSORS_MACSMC_HWMON \
+  --enable ARM_APPLE_SOC_CPUFREQ \
+  --enable APPLE_ADMAC \
+  --enable APPLE_M1_CPU_PMU \
+  --enable COMMON_CLK_APPLE_NCO \
+  --enable ARM_APPLE_CPUIDLE \
+  --module TOUCHSCREEN_APPLE_Z2 \
+  --disable ARM64_4K_PAGES \
+  --enable ARM64_16K_PAGES \
+  --disable ARM64_64K_PAGES
+
+before="$(mktemp)"
+trap 'rm -f "${before}"' EXIT
+cp .config "${before}"
+
+make ARCH=arm64 olddefconfig
+
+echo "Asahi kernel olddefconfig changes:"
+scripts/diffconfig "${before}" .config
+
+check_config() {
+  local symbol="$1"
+  local expected="$2"
+  local actual
+
+  actual="$(scripts/config --state "${symbol}")"
+  if [[ "${actual}" != "${expected}" ]]; then
+    printf 'olddefconfig changed CONFIG_%s from %s to %s\n' "${symbol}" "${expected}" "${actual}" >&2
+    return 1
+  fi
+}
+
+for symbol in \
+  ARCH_APPLE \
+  ARM64_MEMORY_MODEL_CONTROL \
+  APPLE_AIC \
+  APPLE_WATCHDOG \
+  APPLE_DART \
+  APPLE_SART \
+  APPLE_MAILBOX \
+  APPLE_RTKIT \
+  APPLE_RTKIT_HELPER \
+  MFD_MACSMC \
+  APPLE_PMGR_PWRSTATE \
+  APPLE_PMGR_MISC \
+  I2C_APPLE \
+  NVME_APPLE \
+  PCIE_APPLE \
+  PINCTRL_APPLE_GPIO \
+  PWM_APPLE \
+  SPI_APPLE \
+  SPMI_APPLE \
+  GPIO_MACSMC \
+  ARM_APPLE_SOC_CPUFREQ \
+  APPLE_ADMAC \
+  APPLE_M1_CPU_PMU \
+  COMMON_CLK_APPLE_NCO \
+  ARM_APPLE_CPUIDLE \
+  ARM64_16K_PAGES; do
+  check_config "${symbol}" y
+done
+
+for symbol in SENSORS_MACSMC_HWMON TOUCHSCREEN_APPLE_Z2; do
+  check_config "${symbol}" m
+done
+
+for symbol in ARM64_4K_PAGES ARM64_64K_PAGES; do
+  check_config "${symbol}" n
+done
diff --git a/kernel/build/pkg.yaml b/kernel/build/pkg.yaml
index 40f25d5..8e6dacf 100644
--- a/kernel/build/pkg.yaml
+++ b/kernel/build/pkg.yaml
@@ -13,12 +13,13 @@ steps:
         cd /src
         cp -v /pkg/config-${CARCH} .config
         cp -v /pkg/certs/* certs/
+      - |
+        if [[ "${ARCH}" == "arm64" ]]; then
+          /pkg/configure-asahi-arm64.sh /src
+        fi
       - |
         cd /src
-        for patch in $(find /pkg/patches -type f -name "*.patch" | sort); do
-          patch -p1 < $patch || (echo "Failed to apply patch $patch" && exit 1)
-          echo "Applied patch $patch"
-        done
+        echo "Skipping Talos stable-kernel patches for the Asahi downstream tree"
     build:
       {{ if .BUILD_ARG_KERNEL_TARGET }}
       - |
@@ -28,7 +29,12 @@ steps:
       {{ else }}
       - |
         cd /src
-        python3 /toolchain/kernel-hardening-checker/bin/kernel-hardening-checker -c .config -m json | python3 /pkg/scripts/filter-hardened-check.py ${CARCH}
+        # The checker bundled with Talos 1.13 still requires the removed
+        # ARM64_PAN symbol. Linux 7.1 exposes SW_TTBR0_PAN and EPAN instead.
+        # Keep the report visible, but do not fail this experimental kernel.
+        python3 /toolchain/kernel-hardening-checker/bin/kernel-hardening-checker -c .config -m json | \
+          python3 /pkg/scripts/filter-hardened-check.py ${CARCH} || \
+          echo "warning: hardening checker is not yet Linux 7.1 aware"
       - |
         cd /src
 
@@ -39,14 +45,35 @@ steps:
           echo "Compiling device-tree blobs"
           make -j $(nproc) DTC_FLAGS=-@ dtbs
         fi
+      - |
+        cd /src
+
+        mkdir -p /kernel-out/boot /kernel-out/dtb /kernel-out/certs
+
+        case "${ARCH}" in
+          x86)
+            cp arch/x86/boot/bzImage /kernel-out/boot/vmlinuz
+            ;;
+          arm64)
+            cp arch/arm64/boot/vmlinuz.efi /kernel-out/boot/vmlinuz
+            cd arch/arm64/boot/dts
+            find . -type f -name "*.dtb" -exec cp --parents {} /kernel-out/dtb/ \;
+            cd /src
+            ;;
+        esac
+
+        cp System.map /kernel-out/boot/System.map
+
+        KERNELRELEASE=$(cat include/config/kernel.release)
+        make -j $(nproc) modules_install INSTALL_MOD_PATH=/kernel-out/usr INSTALL_MOD_STRIP=1
+        depmod -b /kernel-out/usr -F /kernel-out/boot/System.map --errsyms -w "${KERNELRELEASE}"
+        unlink "/kernel-out/usr/lib/modules/${KERNELRELEASE}/build"
       {{ end }}
 finalize:
   {{ if .BUILD_ARG_KERNEL_TARGET }}
   - from: /src/.config
     to: config-{{ if eq .ARCH "aarch64"}}arm64{{ else if eq .ARCH "x86_64" }}amd64{{ else }}unsupported{{ end }}
   {{ else }}
-  - from: /src
-    to: /src
-  - from: /toolchain
-    to: /toolchain
+  - from: /kernel-out
+    to: /kernel-out
   {{ end }}
